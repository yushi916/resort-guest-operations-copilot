    {
      "parameters": {
        "jsCode": "// 读取飞书标准化消息\nconst message =\n  $('Normalize Feishu Message').item.json;\n\n// 读取 Guest Operations Intelligence 的判断结果\nconst ai =\n  $('Run Guest Operations Intelligence').item.json;\n\n// 合并业务字段、路由结果和 RAG 审计信息\nreturn [\n  {\n    json: {\n      eventId: message.eventId,\n      messageId: message.messageId,\n      chatId: message.chatId,\n      senderOpenId: message.senderOpenId,\n      text: message.text,\n\n      category: ai.category,\n      priority: ai.priority,\n      summary: ai.summary,\n      suggestedReply: ai.suggestedReply,\n\n      requiresApproval: ai.requiresApproval,\n      needsHumanEscalation: ai.needsHumanEscalation,\nrequiresBookingWorkflow:\n  ai.requiresBookingWorkflow === true,\n      hasOperationalRequest:\n  ai.hasOperationalRequest === true,\n\noperationalRequestText:\n  ai.operationalRequestText ?? '',\n\nbookingRequestText:\n  ai.bookingRequestText ?? '',\nroute: ai.route,\nfinalReply: ai.finalReply,\n\n      ragGrounded: ai.ragGrounded === true,\n      sopSource: ai.sopSource ?? null,\n      sopVersion: ai.sopVersion ?? null,\n      retrievalCount: Number.isFinite(Number(ai.retrievalCount))\n        ? Number(ai.retrievalCount)\n        : 0,\n      retrievalTopScore:\n        typeof ai.retrievalTopScore === 'number'\n          ? ai.retrievalTopScore\n          : null\n    }\n  }\n];"
      },
