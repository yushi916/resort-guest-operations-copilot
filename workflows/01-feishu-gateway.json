    {
      "parameters": {
        "jsCode": "// // Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// for (const item of $input.all()) {\n//   item.json.myNewField = 1;\n// }\n\n// return $input.all();\nconst expectedToken = '01ZQJosdoGfdPTQBj6LVfd0cpCH66sIT';\nconst items = $input.all();\n\nfor (const item of items) {\n  const body = item.json.body ?? {};\n  const receivedToken = body.token ?? body.header?.token;\n\n  if (!receivedToken || receivedToken !== expectedToken) {\n    throw new Error('Unauthorized Feishu request');\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        80
      ],
      "id": "f6e22279-65bb-4c9d-b10f-7fbfeafc00f8",
      "name": "Validate Feishu Token"
    },
    {
      "parameters": {
        "jsCode": "// // Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// for (const item of $input.all()) {\n//   item.json.myNewField = 1;\n// }\n\n// return $input.all();\nconst input = $input.first().json;\nconst body = input.body ?? {};\nconst header = body.header ?? {};\nconst event = body.event ?? {};\nconst message = event.message ?? {};\n\n// 只处理“收到消息”事件\nif (header.event_type !== 'im.message.receive_v1') {\n  return [];\n}\n\n// 第一版只处理文本\nif (message.message_type !== 'text') {\n  return [];\n}\n\nlet content;\n\ntry {\n  content = JSON.parse(message.content ?? '{}');\n} catch {\n  throw new Error('Invalid Feishu message content');\n}\n\nreturn [\n  {\n    json: {\n      eventId: header.event_id,\n      eventType: header.event_type,\n      senderOpenId: event.sender?.sender_id?.open_id ?? '',\n      chatId: message.chat_id ?? '',\n      messageId: message.message_id ?? '',\n      messageType: message.message_type,\n      text: (content.text ?? '').trim()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        80
      ],
